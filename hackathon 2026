import pygame
pygame.init() #starts the pygame modules
sol = 1
food = '10 tonnes'
power = '100%'
oxygen_level = 21 
radiation_exposure = 20


if 19.5 <= oxygen_level <= 23.5:
    oxygen_text = 'This level is Safe'
elif oxygen_level < 19.5:
    oxygen_text = 'This level is Low. You need to increase oxygen levels'
else:
    oxygen_text = 'This level is High. You need to decrease oxygen levels'


if radiation_exposure < 100:
    radiation_text = 'This level is Safe'
elif radiation_exposure >= 100 and radiation_exposure <= 1000:
    radiation_text = 'This level is Moderate'
else:
    radiation_text = 'This level is High'


font1 = pygame.font.Font(None, 16) #creates a font object with the default font and size 16
Sol_text = font1.render("Sol:" + str(sol), True, (255, 255, 255)) # 'true' makes the text smoother (it makes the text have smoother edges), (255, 255, 255) makes the text white
Food_amount = font1.render("Food: " + food, True, (255, 255, 255)) 
Power_level = font1.render("Power: " + power, True, (255, 255, 255))
Oxygen_level = font1.render("Oxygen: " + str(oxygen_level), True, (255, 255, 255))
Radiation_exposure_level = font1.render("Radiation Exposure: " + str(radiation_exposure) + 'mSv', True, (255, 255, 255))


print(Sol_text)
print(Food_amount)
print(Power_level)
print(Oxygen_level)
print(Radiation_exposure_level)

font2 = pygame.font.Font(None, 12) #creates a font object with the default font and size 12

def popup_messages():
    if oxygen_text != 'This level is safe':
        message1 = font2.render(oxygen_text, True, (255, 0, 0)) #makes the text red if the oxygen level is not safe
    else:
        message1 = font2.render(oxygen_text, True, (0, 255, 0)) #makes the text green if the oxygen level is safe
        return  message1
    if radiation_text != 'This level is safe':
        message2 = font2.render(radiation_text, True, (255, 0, 0)) #makes the text red if the radiation level is not safe
    else:
        message2 = font2.render(radiation_text, True, (0, 255, 0)) #makes the text green if the radiation level is safe
        return message2

print(popup_messages()) 


clock = pygame.time.Clock() #creates a clock object to manage time
running = True


while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT: #if the user tries to close the window by clicking the X on the top, pygame realises it. pygame.QUIT means the user clicked X to close the window
            running = False

        elif pygame.time.get_ticks() == 600000: #checks if 600000 milliseconds have elapsed since the game started
            sol += 1 #increments the sol days
            print("You are now on Sol:" + str(sol) + ". Please check the events calender for a list of the day's challenges!" )
        






























